      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/market/market",
      "style": {
        "navigationBarTitleText": "行情"
      }
    },
    {
      "path": "pages/discovery/discovery",
