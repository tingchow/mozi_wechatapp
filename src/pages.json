  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "Mozi UniApp",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#45e87f",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/images/tabbar/home-default.png",
        "selectedIconPath": "static/images/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/market/market",
        "text": "行情",
        "iconPath": "static/images/tabbar/market-default.png",
        "selectedIconPath": "static/images/tabbar/market-active.png"
      },
      {
        "pagePath": "pages/discovery/discovery",
        "text": "发现",
        "iconPath": "static/images/tabbar/discovery-default.png",
        "selectedIconPath": "static/images/tabbar/discovery-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "static/images/tabbar/profile-default.png",
        "selectedIconPath": "static/images/tabbar/profile-active.png"
      }
    ]
